{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Smart Scan",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}",
      "args": ["."],
      "env": {
        "LOG_LEVEL": "DEBUG",
        "FOLDERS_TO_IGNORE": ".git, llc",
        "FOLDERS_TO_REMOVE": "node_modules",
        "REMOVE_OWNER_FOLDERS": "zip",
        "REMOVE_FILE_TYPES": "json, js, dmg"
      }
    }
  ]
}
